{
    "tableReference": {
        "projectId": "${PROJECT_ID}",
        "datasetId": "silver",
        "tableId": "silver_platforms"
    },
    "description": "Cleans and standardises the raw_ticketing.platforms reference table. Platforms are a slowly-changing dimension (SCD-1) retaining only the current state. This model standardises platform_name and platform_region, and deduplicates on platform_id. Used as a dimension in gold models to provide regional context for ticket sales and channel attribution.",
    "labels": {
        "layer": "silver",
        "domain": "ticketing",
        "team": "data_engineering",
        "pii_present": "false",
        "managed_by": "bq_cli",
        "env": "${ENV}"
    },
    "schema": {
        "fields": [
            {
                "name": "platform_id",
                "mode": "",
                "type": "STRING",
                "description": "Primary key for the platform",
                "fields": []
            },
            {
                "name": "platform_name",
                "mode": "",
                "type": "STRING",
                "description": "Standardised platform name (INITCAP)",
                "fields": []
            },
            {
                "name": "platform_region",
                "mode": "",
                "type": "STRING",
                "description": "Standardised platform region (UPPER)",
                "fields": []
            },
            {
                "name": "launch_date",
                "mode": "",
                "type": "DATE",
                "description": "Date the platform was launched",
                "fields": []
            },
            {
                "name": "is_active",
                "mode": "",
                "type": "BOOLEAN",
                "description": "Flag indicating if the platform is currently active",
                "fields": []
            },
            {
                "name": "_dbt_loaded_at",
                "mode": "",
                "type": "TIMESTAMP",
                "description": "Timestamp when the record was processed by dbt",
                "fields": []
            }
        ]
    },
    "timePartitioning": {
        "type": "DAY",
        "field": "launch_date",
        "requirePartitionFilter": false
    },
    "clustering": {
        "fields": [
            "platform_name",
            "platform_region",
            "is_active"
        ]
    }
}